  <!--
    Grasshopper only loads plug-ins named *.gha, so ship a copy of CarboCroc.dll under
    that extension. The TargetFramework condition keeps this out of the outer,
    multi-targeting pass, where OutputPath has no framework folder and nothing has been
    copied yet.
  -->
  <Target Name="RenameLibDllToGha" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <ItemGroup>
      <LibDll Include="$(OutputPath)CarboCroc.dll" />
    </ItemGroup>

    <!-- Rename the DLL to GHA -->
    <Copy SourceFiles="@(LibDll)" DestinationFiles="$(OutputPath)CarboCroc.gha" SkipUnchangedFiles="true" />
  </Target>
