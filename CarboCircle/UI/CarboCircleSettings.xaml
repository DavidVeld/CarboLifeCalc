<Window x:Class="CarboCircle.UI.CarboCircleSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:CarboCircle.UI"
        mc:Ignorable="d"
        Title="CarboCircle : Settings"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        FontWeight="Normal"
        FontSize="12"
        Width="880" Height="880"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MyStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ══════════════════════════════════════════════════════════════════ -->
            <!-- Local conveniences.                                                -->
            <!--                                                                    -->
            <!-- Every row on this window is the same shape - caption, value, unit - -->
            <!-- so the shape is described once here. The previous version positioned -->
            <!-- each control with its own hand-tuned Margin, which is why captions   -->
            <!-- overlapped their fields and nothing survived a resize.              -->
            <!-- ══════════════════════════════════════════════════════════════════ -->

            <Style x:Key="RowCaption" TargetType="{x:Type Label}" BasedOn="{StaticResource formTextStyle}">
                <Setter Property="Padding"           Value="0,0,10,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>

            <Style x:Key="RowValue" TargetType="{x:Type TextBox}" BasedOn="{StaticResource flatTextBox}">
                <Setter Property="Height"            Value="26"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin"            Value="0,3,0,3"/>
            </Style>

            <Style x:Key="RowUnit" TargetType="{x:Type Label}" BasedOn="{StaticResource formGreyText}">
                <Setter Property="Padding"           Value="6,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="MinWidth"          Value="24"/>
            </Style>

            <!--
                Advisory note under a row whose value has consequences off this window.
                Amber rather than the house red, which is the chrome on every screen here and
                would read as furniture. Collapsed until the value earns it.
            -->
            <Style x:Key="RowWarning" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground"   Value="#FF8A6800"/>
                <Setter Property="FontFamily"   Value="Segoe UI"/>
                <Setter Property="FontSize"     Value="10"/>
                <Setter Property="FontWeight"   Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin"       Value="0,0,0,6"/>
                <Setter Property="Visibility"   Value="Collapsed"/>
            </Style>

            <!--
                Divides one group into the parts it is actually made of - here, the source
                model and the proposed design. Small and spaced rather than bold and boxed:
                it has to separate two rows without competing with the GroupBox header above
                them.
            -->
            <Style x:Key="SubHeader" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground"    Value="{StaticResource PrimaryAccentBrush}"/>
                <Setter Property="FontFamily"    Value="Segoe UI"/>
                <Setter Property="FontSize"      Value="10"/>
                <Setter Property="FontWeight"    Value="SemiBold"/>
                <Setter Property="Margin"        Value="0,8,0,2"/>
                <Setter Property="TextWrapping"  Value="Wrap"/>
            </Style>

            <!--
                A value the import decides for itself. Read-only rather than disabled, so
                the text can still be selected and copied and a screen reader still reads
                it, but greyed so it plainly is not a box to type in.
            -->
            <Style x:Key="FixedValueBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource flatTextBox}">
                <Setter Property="Height"            Value="26"/>
                <Setter Property="IsReadOnly"        Value="True"/>
                <Setter Property="IsTabStop"         Value="False"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin"            Value="0,3,0,3"/>
                <Setter Property="Foreground"        Value="{StaticResource DisabledTextBrush}"/>
                <Setter Property="Background"        Value="{StaticResource DisabledBackBrush}"/>
            </Style>

            <Style x:Key="GroupNote" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground"   Value="{StaticResource SubtleBrush}"/>
                <Setter Property="FontFamily"   Value="Segoe UI"/>
                <Setter Property="FontSize"     Value="10"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin"       Value="0,0,0,8"/>
            </Style>

            <Style x:Key="SettingsCheckBox" TargetType="{x:Type CheckBox}">
                <Setter Property="Margin"            Value="0,5,0,5"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- The two database rows are read-only rather than disabled: a disabled box
                 cannot be focused or copied from, and screen readers skip it. Read-only
                 keeps the path reachable while still making clear it is set by Browse. -->
            <Style x:Key="PathBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource flatTextBox}">
                <Setter Property="Height"            Value="26"/>
                <Setter Property="IsReadOnly"        Value="True"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin"            Value="0,3,6,3"/>
                <Setter Property="Foreground"        Value="{StaticResource SubtleBrush}"/>
            </Style>

            <Style x:Key="BrowseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonStyle}">
                <Setter Property="Width"             Value="30"/>
                <Setter Property="Height"            Value="26"/>
                <Setter Property="Padding"           Value="0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: title            -->
            <RowDefinition Height="*"/>
            <!-- 1: the two columns  -->
            <RowDefinition Height="Auto"/>
            <!-- 2: footer buttons   -->
        </Grid.RowDefinitions>

        <!-- ── Title ──────────────────────────────────────────────────────────── -->
        <Label Grid.Row="0"
               Style="{StaticResource WindowTitleStyle}"
               Padding="0,0,0,0"
               Margin="0,0,0,14"
               Content="CarboCircle Settings"/>

        <!-- ── Body: two columns, grouped by the question each group answers ──── -->
        <!--
            The window is 880 tall because that is what these two columns measure to at
            880 wide. At the original 655 this viewer reported a 664 px extent in a 502 px
            viewport, so the cross-family checkbox and half the Databases group opened out
            of sight behind a scrollbar. The viewer stays for a short screen; on a normal
            one it now has nothing to do.

            If a group is added, measure rather than guess: ExtentHeight against
            ViewportHeight on this viewer says exactly how much is hidden.
        -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════════════ LEFT COLUMN ═══════════════════ -->
                <StackPanel Grid.Column="0">

                    <!-- ── 1. What the import looks at ──────────────────────── -->
                    <GroupBox Header="What to collect" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GroupNote}"
                                       Text="Which Revit categories an import reads. Beams and columns are read as sections that can be substituted; walls and floors are read as volumes of material."/>

                            <CheckBox x:Name="chk_MineSteelBeams"
                                      Style="{StaticResource SettingsCheckBox}"
                                      Content="Structural framing and columns"
                                      ToolTip="Read beams and columns. These are matched against the steel section table and can be substituted for one another."/>
                            <CheckBox x:Name="chk_MineWalls"
                                      Style="{StaticResource SettingsCheckBox}"
                                      Content="Walls"
                                      ToolTip="Read walls as volumes of material. A compound wall contributes one entry per structural layer."/>
                            <CheckBox x:Name="chk_MineFloors"
                                      Style="{StaticResource SettingsCheckBox}"
                                      Content="Floors"
                                      ToolTip="Read floors as volumes of material. A compound floor contributes one entry per structural layer."/>
                        </StackPanel>
                    </GroupBox>

                    <!-- ── 2. What deconstruction costs ─────────────────────── -->
                    <GroupBox Header="Lost in deconstruction" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GroupNote}"
                                       Text="How much of an existing element does not survive being taken out. Applied to mined material only - a proposed element always needs its full size."/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label   Grid.Row="0" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_CutoffValue}"
                                         Content="Steel _members, cut off each end"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt_CutoffValue"
                                         Style="{StaticResource RowValue}"
                                         TextChanged="txt_Cutoff_TextChanged"
                                         ToolTip="Length lost cutting a steel member free, per end. 600 mm is a common allowance."/>
                                <Label   Grid.Row="0" Grid.Column="2" Style="{StaticResource RowUnit}" Content="mm"/>

                                <!-- Shown by refreshCutoffWarnings() below the advisory minimum. The
                                     same note appears on the main window, off the same constants, so
                                     lowering the value here cannot slip past it. -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                           x:Name="txt_CutoffValueWarning" Style="{StaticResource RowWarning}"/>

                                <Label   Grid.Row="2" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_WoodCutoff}"
                                         Content="_Timber members, cut off each end"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txt_WoodCutoff"
                                         Style="{StaticResource RowValue}"
                                         TextChanged="txt_Cutoff_TextChanged"
                                         ToolTip="Length lost cutting a timber member free, per end. 300 mm is a common allowance."/>
                                <Label   Grid.Row="2" Grid.Column="2" Style="{StaticResource RowUnit}" Content="mm"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                           x:Name="txt_WoodCutoffWarning" Style="{StaticResource RowWarning}"/>

                                <Label   Grid.Row="4" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_ConcreteLoss}"
                                         Content="_Concrete volume lost"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="txt_ConcreteLoss"
                                         Style="{StaticResource RowValue}"
                                         ToolTip="Share of a concrete volume lost in deconstruction. 25% is the usual figure. Enter 0 for no loss."/>
                                <Label   Grid.Row="4" Grid.Column="2" Style="{StaticResource RowUnit}" Content="%"/>

                                <Label   Grid.Row="5" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_MasonryLoss}"
                                         Content="M_asonry volume lost"/>
                                <TextBox Grid.Row="5" Grid.Column="1" x:Name="txt_MasonryLoss"
                                         Style="{StaticResource RowValue}"
                                         ToolTip="Share of a masonry volume lost in deconstruction. 25% is the usual figure. Enter 0 for no loss."/>
                                <Label   Grid.Row="5" Grid.Column="2" Style="{StaticResource RowUnit}" Content="%"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- ── 3. How far a substitution may stray ──────────────── -->
                    <GroupBox Header="Substitution tolerances" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GroupNote}"
                                       Text="How much bigger than the requirement a mined member may be and still count as a match. Zero means only an exact section will do."/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label   Grid.Row="0" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_SteelBeamDepthTolerance}"
                                         Content="Permitted extra section _depth"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt_SteelBeamDepthTolerance"
                                         Style="{StaticResource RowValue}"
                                         ToolTip="A mined member may be this much deeper than the one it replaces."/>
                                <Label   Grid.Row="0" Grid.Column="2" Style="{StaticResource RowUnit}" Content="mm"/>

                                <Label   Grid.Row="1" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_BeamStrengthTolerance}"
                                         Content="Permitted extra _strength"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txt_BeamStrengthTolerance"
                                         Style="{StaticResource RowValue}"
                                         ToolTip="A substitute may carry this much more bending capacity than the member it replaces. Consecutive serial sizes differ by 10-18%, so below about 15% almost nothing but the exact section qualifies."/>
                                <Label   Grid.Row="1" Grid.Column="2" Style="{StaticResource RowUnit}" Content="%"/>

                                <Label   Grid.Row="2" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_WidthTolerance}"
                                         Content="Permitted extra section _width"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txt_WidthTolerance"
                                         Style="{StaticResource RowValue}"
                                         ToolTip="A substitute may be this much wider than the member it replaces. Without it a 254 mm wide column section would be offered for a 165 mm wide beam purely because it is shallow enough, and it would not fit the detail it has to sit in."/>
                                <Label   Grid.Row="2" Grid.Column="2" Style="{StaticResource RowUnit}" Content="mm"/>

                                <Label   Grid.Row="3" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_MinOffcutLength}"
                                         Content="Shortest _offcut worth keeping"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txt_MinOffcutLength"
                                         Style="{StaticResource RowValue}"
                                         ToolTip="A remnant shorter than this is reported as waste rather than offered again - below it the handling and the second saw cut cost more than the steel is worth."/>
                                <Label   Grid.Row="3" Grid.Column="2" Style="{StaticResource RowUnit}" Content="mm"/>
                            </Grid>

                            <CheckBox x:Name="chk_AllowCrossFamily"
                                      Style="{StaticResource SettingsCheckBox}"
                                      Margin="0,10,0,0"
                                      Content="Allow column sections to serve beams"
                                      ToolTip="Permits a UC, UKC or HE section to substitute for a UB, UKB or IPE requirement. At equal bending capacity a column section is shallower and much stiffer about its minor axis, so it makes a sound beam - but the shape changes, so every connection on the member has to be re-detailed. The reverse substitution is never offered."/>

                            <TextBlock Style="{StaticResource GroupNote}"
                                       Margin="0,6,0,0"
                                       Text="Angles and channels are only ever offered as an exact section. The published properties for them describe the wrong axes, so there is no sound basis here for substituting one size for another."/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <!-- ═══════════════════ RIGHT COLUMN ═══════════════════ -->
                <StackPanel Grid.Column="2">

                    <!-- ── 4. Where the import reads the section name from ──── -->
                    <!--
                        Split by side, because the two sides are usually two different
                        Revit files with two different conventions: the building being
                        stripped is often an old model whose types are named anything at
                        all, while the proposed design is the user's own and tidy. One
                        shared box forced one answer on both.

                        The value shown is "Type name" rather than an empty box. That is
                        the same setting the empty box stood for - it is what the import
                        falls back to - but as a value the user can see and compare
                        against the alternatives in the same list, instead of a blank that
                        needed a sentence of explanation underneath it.
                    -->
                    <GroupBox Header="Where the section name comes from" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GroupNote}"
                                       Text="Every element is identified by a section name, which is looked up in the section table. Pick which type parameter holds it - start typing to search the parameters in this model."/>

                            <TextBlock Style="{StaticResource SubHeader}"
                                       Text="SOURCE MODEL - what is being stripped"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label    Grid.Column="0" Style="{StaticResource RowCaption}"
                                          Target="{Binding ElementName=cmb_MinedParameter}"
                                          Content="Section _name"/>
                                <ComboBox Grid.Column="1" x:Name="cmb_MinedParameter"
                                          Style="{StaticResource ParameterCombo}"
                                          Height="26" Margin="0,3,0,3"
                                          ToolTip="Type parameter holding the section size of a mined element, for example &quot;UB 305x165x40&quot;. Leave it on Type name to use the Revit type name."/>
                            </Grid>

                            <TextBlock Style="{StaticResource SubHeader}"
                                       Text="PROPOSED DESIGN - what is being built"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label    Grid.Column="0" Style="{StaticResource RowCaption}"
                                          Target="{Binding ElementName=cmb_RequiredParameter}"
                                          Content="Section na_me"/>
                                <ComboBox Grid.Column="1" x:Name="cmb_RequiredParameter"
                                          Style="{StaticResource ParameterCombo}"
                                          Height="26" Margin="0,3,0,3"
                                          ToolTip="Type parameter holding the section size of a required element. Leave it on Type name to use the Revit type name."/>
                            </Grid>

                            <!-- Shown by the code-behind only when no model has been read,
                                 so an empty dropdown reads as "nothing harvested yet"
                                 rather than as a broken control. -->
                            <TextBlock x:Name="txt_NoParametersNote"
                                       Style="{StaticResource RowWarning}"
                                       Margin="0,6,0,0"
                                       Text="No model has been read yet, so the lists hold nothing to choose from. Type a parameter name, or mine a view first and reopen this window."/>
                        </StackPanel>
                    </GroupBox>

                    <!-- ── 5. What gets written back ───────────────────────── -->
                    <!--
                        The only place CarboCircle writes to the model, and it only happens
                        when the user presses the button on the main window. An INSTANCE
                        parameter: two beams of one type are two different pieces of steel
                        and have to be able to carry different ids.
                    -->
                    <GroupBox Header="Writing the reuse ID back" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GroupNote}"
                                       Text="&quot;Write reuse IDs&quot; on the results tab stamps each matched pair with the same id - on the new member and on the existing one it comes out of - so the link can be scheduled and filtered in Revit."/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label    Grid.Column="0" Style="{StaticResource RowCaption}"
                                          Target="{Binding ElementName=cmb_ReuseIdParameter}"
                                          Content="_Reuse ID"/>
                                <ComboBox Grid.Column="1" x:Name="cmb_ReuseIdParameter"
                                          Style="{StaticResource ParameterCombo}"
                                          Height="26" Margin="0,3,0,3"
                                          ToolTip="Instance text parameter the reuse id is written into. It has to exist on the structural framing and column categories already - CarboCircle writes values, it does not add parameters to your model."/>
                            </Grid>

                            <TextBlock Style="{StaticResource GroupNote}"
                                       Margin="0,8,0,0"
                                       Text="Must already exist as an instance Text parameter on those categories. Nothing is added to the model; a member that has no such parameter is reported and left alone. Clear the box to go back to CLC_ReuseID."/>
                        </StackPanel>
                    </GroupBox>

                    <!-- ── 6. What the import works out for itself ──────────── -->
                    <!--
                        These three were editable boxes that the import never read. Rather
                        than keep offering a setting that does nothing, each now shows the
                        source the import actually uses, greyed out. The settings file
                        still carries whatever was typed into them before - nothing here
                        writes to it - so enabling them later loses nothing.
                    -->
                    <GroupBox Header="Worked out automatically" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GroupNote}"
                                       Text="Not settings. These values are read from fixed places, shown here so it is clear where they come from."/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label   Grid.Row="0" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Content="Steel grade"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt_SteelGradeParameter"
                                         Style="{StaticResource FixedValueBox}"
                                         Text="Material class of the Revit material"
                                         ToolTip="Grade is taken from the material class on the element's material, not from a type parameter."/>

                                <Label   Grid.Row="1" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Content="Timber width"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txt_ParameterWidth"
                                         Style="{StaticResource FixedValueBox}"
                                         Text="Type parameter &quot;b&quot;"
                                         ToolTip="Timber width is read from the type parameter b, the name Revit's own timber families use."/>

                                <Label   Grid.Row="2" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Content="Timber depth"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txt_ParameterDepth"
                                         Style="{StaticResource FixedValueBox}"
                                         Text="Type parameter &quot;d&quot;"
                                         ToolTip="Timber depth is read from the type parameter d, the name Revit's own timber families use."/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- ── 5. Which files the numbers come from ─────────────── -->
                    <GroupBox Header="Databases" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GroupNote}"
                                       Text="Both fall back to the copy shipped in the circledb folder when nothing is chosen, shown here as Local."/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label   Grid.Row="0" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_SteelDataBasePath}"
                                         Content="Steel se_ctions"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt_SteelDataBasePath"
                                         Style="{StaticResource PathBox}"
                                         ToolTip="Csv table of steel sections and their properties. Mined members are mapped onto the nearest entry in this table."/>
                                <Button  Grid.Row="0" Grid.Column="2" x:Name="btn_Browse"
                                         Style="{StaticResource BrowseButton}"
                                         Content="..."
                                         ToolTip="Choose a steel section table"
                                         Click="btn_Browse_Click"/>

                                <Label   Grid.Row="1" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_MaterialDataBasePath}"
                                         Content="Reuse mater_ials"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txt_MaterialDataBasePath"
                                         Style="{StaticResource PathBox}"
                                         ToolTip="Carbo Life material file supplying the carbon values for reused material. Point this at one of the main application databases to use those figures."/>
                                <Button  Grid.Row="1" Grid.Column="2" x:Name="btn_BrowseMaterials"
                                         Style="{StaticResource BrowseButton}"
                                         Content="..."
                                         ToolTip="Choose a reuse material database"
                                         Click="btn_BrowseMaterials_Click"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ── Footer ─────────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <!-- Named btn_Close for the existing handler, but labelled for what it does:
                 it discards the edits rather than saving them.

                 Deliberately not IsCancel="True". The handler already calls Close(), and a
                 cancel button in a ShowDialog window also sets DialogResult afterwards -
                 an interaction worth being sure about rather than guessing at, and one
                 that cannot be exercised outside Revit. Escape therefore does not close
                 this window; add IsCancel and drop the Close() from btn_Close_Click if you
                 want it. -->
            <Button x:Name="btn_Close"
                    Style="{StaticResource ButtonStyle}"
                    Width="90" Height="27"
                    Margin="0,0,10,0"
                    Content="Cancel"
                    ToolTip="Close without keeping any of these changes"
                    Click="btn_Close_Click"/>
            <Button x:Name="btn_Accept"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="90" Height="27"
                    IsDefault="True"
                    Content="Accept"
                    ToolTip="Save these settings and close"
                    Click="btn_Accept_Click"/>
        </StackPanel>
    </Grid>
</Window>
