<Window x:Class="CarboCircle.UI.CarboCircleSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:CarboCircle.UI"
        mc:Ignorable="d"
        Title="CarboCircle : Settings"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        FontWeight="Normal"
        FontSize="12"
        Width="880" Height="655"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MyStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ══════════════════════════════════════════════════════════════════ -->
            <!-- Local conveniences.                                                -->
            <!--                                                                    -->
            <!-- Every row on this window is the same shape - caption, value, unit - -->
            <!-- so the shape is described once here. The previous version positioned -->
            <!-- each control with its own hand-tuned Margin, which is why captions   -->
            <!-- overlapped their fields and nothing survived a resize.              -->
            <!-- ══════════════════════════════════════════════════════════════════ -->

            <Style x:Key="RowCaption" TargetType="{x:Type Label}" BasedOn="{StaticResource formTextStyle}">
                <Setter Property="Padding"           Value="0,0,10,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>

            <Style x:Key="RowValue" TargetType="{x:Type TextBox}" BasedOn="{StaticResource flatTextBox}">
                <Setter Property="Height"            Value="26"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin"            Value="0,3,0,3"/>
            </Style>

            <Style x:Key="RowUnit" TargetType="{x:Type Label}" BasedOn="{StaticResource formGreyText}">
                <Setter Property="Padding"           Value="6,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="MinWidth"          Value="24"/>
            </Style>

            <Style x:Key="GroupNote" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground"   Value="{StaticResource SubtleBrush}"/>
                <Setter Property="FontFamily"   Value="Segoe UI"/>
                <Setter Property="FontSize"     Value="10"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin"       Value="0,0,0,8"/>
            </Style>

            <Style x:Key="SettingsCheckBox" TargetType="{x:Type CheckBox}">
                <Setter Property="Margin"            Value="0,5,0,5"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- The two database rows are read-only rather than disabled: a disabled box
                 cannot be focused or copied from, and screen readers skip it. Read-only
                 keeps the path reachable while still making clear it is set by Browse. -->
            <Style x:Key="PathBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource flatTextBox}">
                <Setter Property="Height"            Value="26"/>
                <Setter Property="IsReadOnly"        Value="True"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin"            Value="0,3,6,3"/>
                <Setter Property="Foreground"        Value="{StaticResource SubtleBrush}"/>
            </Style>

            <Style x:Key="BrowseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonStyle}">
                <Setter Property="Width"             Value="30"/>
                <Setter Property="Height"            Value="26"/>
                <Setter Property="Padding"           Value="0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: title            -->
            <RowDefinition Height="*"/>
            <!-- 1: the two columns  -->
            <RowDefinition Height="Auto"/>
            <!-- 2: footer buttons   -->
        </Grid.RowDefinitions>

        <!-- ── Title ──────────────────────────────────────────────────────────── -->
        <Label Grid.Row="0"
               Style="{StaticResource WindowTitleStyle}"
               Padding="0,0,0,0"
               Margin="0,0,0,14"
               Content="CarboCircle Settings"/>

        <!-- ── Body: two columns, grouped by the question each group answers ──── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════════════ LEFT COLUMN ═══════════════════ -->
                <StackPanel Grid.Column="0">

                    <!-- ── 1. What the import looks at ──────────────────────── -->
                    <GroupBox Header="What to collect" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GroupNote}"
                                       Text="Which Revit categories an import reads. Beams and columns are read as sections that can be substituted; walls and floors are read as volumes of material."/>

                            <CheckBox x:Name="chk_MineSteelBeams"
                                      Style="{StaticResource SettingsCheckBox}"
                                      Content="Structural framing and columns"
                                      ToolTip="Read beams and columns. These are matched against the steel section table and can be substituted for one another."/>
                            <CheckBox x:Name="chk_MineWalls"
                                      Style="{StaticResource SettingsCheckBox}"
                                      Content="Walls"
                                      ToolTip="Read walls as volumes of material. A compound wall contributes one entry per structural layer."/>
                            <CheckBox x:Name="chk_MineFloors"
                                      Style="{StaticResource SettingsCheckBox}"
                                      Content="Floors"
                                      ToolTip="Read floors as volumes of material. A compound floor contributes one entry per structural layer."/>
                        </StackPanel>
                    </GroupBox>

                    <!-- ── 2. What deconstruction costs ─────────────────────── -->
                    <GroupBox Header="Lost in deconstruction" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GroupNote}"
                                       Text="How much of an existing element does not survive being taken out. Applied to mined material only - a proposed element always needs its full size."/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label   Grid.Row="0" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_CutoffValue}"
                                         Content="Steel _members, cut off each end"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt_CutoffValue"
                                         Style="{StaticResource RowValue}"
                                         ToolTip="Length lost cutting a steel member free, per end. 600 mm is a common allowance."/>
                                <Label   Grid.Row="0" Grid.Column="2" Style="{StaticResource RowUnit}" Content="mm"/>

                                <Label   Grid.Row="1" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_WoodCutoff}"
                                         Content="_Timber members, cut off each end"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txt_WoodCutoff"
                                         Style="{StaticResource RowValue}"
                                         ToolTip="Length lost cutting a timber member free, per end. 300 mm is a common allowance."/>
                                <Label   Grid.Row="1" Grid.Column="2" Style="{StaticResource RowUnit}" Content="mm"/>

                                <Label   Grid.Row="2" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_ConcreteLoss}"
                                         Content="_Concrete volume lost"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txt_ConcreteLoss"
                                         Style="{StaticResource RowValue}"
                                         ToolTip="Share of a concrete volume lost in deconstruction. 25% is the usual figure. Enter 0 for no loss."/>
                                <Label   Grid.Row="2" Grid.Column="2" Style="{StaticResource RowUnit}" Content="%"/>

                                <Label   Grid.Row="3" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_MasonryLoss}"
                                         Content="M_asonry volume lost"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txt_MasonryLoss"
                                         Style="{StaticResource RowValue}"
                                         ToolTip="Share of a masonry volume lost in deconstruction. 25% is the usual figure. Enter 0 for no loss."/>
                                <Label   Grid.Row="3" Grid.Column="2" Style="{StaticResource RowUnit}" Content="%"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- ── 3. How far a substitution may stray ──────────────── -->
                    <GroupBox Header="Substitution tolerances" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GroupNote}"
                                       Text="How much bigger than the requirement a mined member may be and still count as a match. Zero means only an exact section will do."/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label   Grid.Row="0" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_SteelBeamDepthTolerance}"
                                         Content="Permitted extra section _depth"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt_SteelBeamDepthTolerance"
                                         Style="{StaticResource RowValue}"
                                         ToolTip="A mined member may be this much deeper than the one it replaces."/>
                                <Label   Grid.Row="0" Grid.Column="2" Style="{StaticResource RowUnit}" Content="mm"/>

                                <Label   Grid.Row="1" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_BeamStrengthTolerance}"
                                         Content="Permitted extra _strength"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txt_BeamStrengthTolerance"
                                         Style="{StaticResource RowValue}"
                                         ToolTip="A mined member may be this much stronger than the one it replaces, measured on Iy, Iz, Wely and Welz."/>
                                <Label   Grid.Row="1" Grid.Column="2" Style="{StaticResource RowUnit}" Content="%"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <!-- ═══════════════════ RIGHT COLUMN ═══════════════════ -->
                <StackPanel Grid.Column="2">

                    <!-- ── 4. Where the import reads names and sizes from ───── -->
                    <GroupBox Header="Parameter overrides" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GroupNote}"
                                       Text="By default an element is identified by its Revit type name. Name a type parameter here to use that instead. Leave a box empty to keep the default."/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label   Grid.Row="0" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_MinedParameter}"
                                         Content="Section _name"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt_MinedParameter"
                                         Style="{StaticResource RowValue}"
                                         ToolTip="Type parameter holding the section size, for example &quot;UB 305x165x40&quot;. This is the one parameter override the import reads."/>

                                <Label   Grid.Row="1" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_RequiredParameter}"
                                         Content="Section name, _project side"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txt_RequiredParameter"
                                         Style="{StaticResource RowValue}"
                                         ToolTip="Stored, but not yet read by the import - both sides currently use the mined section name parameter above."/>

                                <Label   Grid.Row="2" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_SteelGradeParameter}"
                                         Content="Steel _grade"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txt_SteelGradeParameter"
                                         Style="{StaticResource RowValue}"
                                         ToolTip="Stored, but not yet read by the import - grade currently comes from the Revit material class."/>

                                <Label   Grid.Row="3" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_ParameterWidth}"
                                         Content="Timber _width"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txt_ParameterWidth"
                                         Style="{StaticResource RowValue}"
                                         ToolTip="Stored, but not yet read by the import - timber sizes currently come from the type parameters b and d."/>

                                <Label   Grid.Row="4" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_ParameterDepth}"
                                         Content="Timber dep_th"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="txt_ParameterDepth"
                                         Style="{StaticResource RowValue}"
                                         ToolTip="Stored, but not yet read by the import - timber sizes currently come from the type parameters b and d."/>
                            </Grid>

                            <!-- Said plainly rather than left for the user to discover: four of
                                 these five boxes are saved and then ignored by the import. -->
                            <TextBlock Style="{StaticResource GroupNote}"
                                       Margin="0,10,0,0"
                                       Text="Only Section name is read by the import at present. The other four are saved with the project but not yet used."/>
                        </StackPanel>
                    </GroupBox>

                    <!-- ── 5. Which files the numbers come from ─────────────── -->
                    <GroupBox Header="Databases" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource GroupNote}"
                                       Text="Both fall back to the copy shipped in the circledb folder when nothing is chosen, shown here as Local."/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label   Grid.Row="0" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_SteelDataBasePath}"
                                         Content="Steel se_ctions"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt_SteelDataBasePath"
                                         Style="{StaticResource PathBox}"
                                         ToolTip="Csv table of steel sections and their properties. Mined members are mapped onto the nearest entry in this table."/>
                                <Button  Grid.Row="0" Grid.Column="2" x:Name="btn_Browse"
                                         Style="{StaticResource BrowseButton}"
                                         Content="..."
                                         ToolTip="Choose a steel section table"
                                         Click="btn_Browse_Click"/>

                                <Label   Grid.Row="1" Grid.Column="0" Style="{StaticResource RowCaption}"
                                         Target="{Binding ElementName=txt_MaterialDataBasePath}"
                                         Content="Reuse mater_ials"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txt_MaterialDataBasePath"
                                         Style="{StaticResource PathBox}"
                                         ToolTip="Carbo Life material file supplying the carbon values for reused material. Point this at one of the main application databases to use those figures."/>
                                <Button  Grid.Row="1" Grid.Column="2" x:Name="btn_BrowseMaterials"
                                         Style="{StaticResource BrowseButton}"
                                         Content="..."
                                         ToolTip="Choose a reuse material database"
                                         Click="btn_BrowseMaterials_Click"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ── Footer ─────────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <!-- Named btn_Close for the existing handler, but labelled for what it does:
                 it discards the edits rather than saving them.

                 Deliberately not IsCancel="True". The handler already calls Close(), and a
                 cancel button in a ShowDialog window also sets DialogResult afterwards -
                 an interaction worth being sure about rather than guessing at, and one
                 that cannot be exercised outside Revit. Escape therefore does not close
                 this window; add IsCancel and drop the Close() from btn_Close_Click if you
                 want it. -->
            <Button x:Name="btn_Close"
                    Style="{StaticResource ButtonStyle}"
                    Width="90" Height="27"
                    Margin="0,0,10,0"
                    Content="Cancel"
                    ToolTip="Close without keeping any of these changes"
                    Click="btn_Close_Click"/>
            <Button x:Name="btn_Accept"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="90" Height="27"
                    IsDefault="True"
                    Content="Accept"
                    ToolTip="Save these settings and close"
                    Click="btn_Accept_Click"/>
        </StackPanel>
    </Grid>
</Window>
