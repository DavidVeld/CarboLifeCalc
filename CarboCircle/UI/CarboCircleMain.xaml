<Window x:Class="CarboCircle.UI.CarboCircleMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CarboCircle : Reuse Materials"
        Background="#FFF4F5F6"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="#FF1F2933"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Height="820" Width="1320"
        MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <!-- ====================================================================
         CarboCircleMain.xaml

         The window reads as four numbered steps: set up, look at what is
         available, look at what is needed, then find the opportunities.
         Everything that used to be scattered across the Overview tab and
         the two import tabs is in that order now.

         The previous layout is kept verbatim in UI\Legacy\CarboCircleMain.xaml
         (excluded from the build in CarboCircle.csproj). Copying it back over
         this file restores the old window; nothing else has to change.

         Every x:Name and every handler here matches CarboCircleMain.xaml.cs
         as it stands - the code-behind is untouched. In particular
         tab_Main.SelectedIndex 1 and 2, which btn_GotoMine and btn_GotoProject
         set, still land on Available stock and Required respectively.
         ==================================================================== -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CarboCircleTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Numbered step badge used in the tab headers. -->
            <Style x:Key="StepBadge" TargetType="Border">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Background" Value="{StaticResource LineSoft}"/>
                <Setter Property="Margin" Value="0,0,9,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="StepBadgeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="BigBadge" TargetType="Border" BasedOn="{StaticResource StepBadge}">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="CornerRadius" Value="11"/>
                <Setter Property="Background" Value="{StaticResource Ink}"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
            </Style>
            <Style x:Key="BigBadgeText" TargetType="TextBlock" BasedOn="{StaticResource StepBadgeText}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <!-- Caption strip that sits directly on top of a grid. -->
            <Style x:Key="ListTitleBar" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="1,1,1,0"/>
                <Setter Property="CornerRadius" Value="6,6,0,0"/>
                <Setter Property="Padding" Value="16,10"/>
            </Style>
            <Style x:Key="ListTitleText" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
            </Style>

            <!--
                Grids sit under a title bar, so they carry no top margin and the
                columns need to be virtualised: the mined and leftover lists can
                run to thousands of rows.
            -->
            <Style x:Key="DataGridList" TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
            </Style>

            <!-- Small button that lives inside a title bar rather than on the action bar. -->
            <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="MinWidth" Value="104"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="tab_Main" Grid.Row="0">

            <!-- ============================== 1. SET UP ============================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="1" Style="{StaticResource StepBadgeText}"/>
                        </Border>
                        <TextBlock Text="Set up" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- What is available -->
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Style="{StaticResource BigBadge}">
                                            <TextBlock Text="1" Style="{StaticResource BigBadgeText}"/>
                                        </Border>
                                        <TextBlock Text="What is available" Style="{StaticResource SectionTitle}"/>
                                    </StackPanel>

                                    <TextBlock Foreground="{StaticResource InkMuted}" Margin="0,0,0,16"
                                               Text="Members and volumes recovered from the existing structure. Pull them from the model, or bring in a survey from CSV."/>

                                    <TextBlock Text="EXTRACTION METHOD" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cbb_MineSetting" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="btn_ImportmaterialsRevit"
                                                Style="{StaticResource CircleStrongButton}"
                                                Content="Read from model"
                                                Click="btn_ImportmaterialsRevit_Click"/>
                                        <Button Grid.Column="1" x:Name="btn_ImportmaterialsCSV"
                                                Content="Import CSV" MinWidth="96"
                                                Click="btn_ImportmaterialsCSV_Click"/>
                                        <Button Grid.Column="2" x:Name="btn_ExportMinedCSV"
                                                Content="Export" MinWidth="76" Margin="0"
                                                Click="btn_ExportMinedToCSV"/>
                                    </Grid>

                                    <!-- Content and style are both set from setMineOk(): red until elements arrive,
                                         then green carrying the totals. -->
                                    <Button x:Name="btn_GotoMine"
                                            Style="{StaticResource CircleStepButton}"
                                            Content="Nothing recovered yet" Margin="0"
                                            Click="btn_GotoMine_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- What is needed -->
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Style="{StaticResource BigBadge}">
                                            <TextBlock Text="2" Style="{StaticResource BigBadgeText}"/>
                                        </Border>
                                        <TextBlock Text="What is needed" Style="{StaticResource SectionTitle}"/>
                                    </StackPanel>

                                    <TextBlock Foreground="{StaticResource InkMuted}" Margin="0,0,0,16"
                                               Text="The proposed frame. Every requirement here is something CarboCircle will try to satisfy from the recovered stock."/>

                                    <TextBlock Text="EXTRACTION METHOD" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cbb_ImportProjectSetting" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="btn_ImportProjectRevit"
                                                Style="{StaticResource CircleStrongButton}"
                                                Content="Read from model"
                                                Click="btn_ImportProjectRevit_Click"/>
                                        <Button Grid.Column="1" x:Name="btn_ImportProjectCSV"
                                                Content="Import CSV" MinWidth="96"
                                                Click="btn_ImportProjectCSV_Click"/>
                                        <Button Grid.Column="2" x:Name="btn_ExportProjectData"
                                                Content="Export" MinWidth="76" Margin="0"
                                                Click="btn_ExportProjectData_Click"/>
                                    </Grid>

                                    <!-- Content and style are both set from setRequiredOk(): red until elements
                                         arrive, then green carrying the totals. -->
                                    <Button x:Name="btn_GotoProject"
                                            Style="{StaticResource CircleStepButton}"
                                            Content="Nothing loaded yet" Margin="0"
                                            Click="btn_GotoProject_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- How closely to match -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Style="{StaticResource BigBadge}">
                                        <TextBlock Text="3" Style="{StaticResource BigBadgeText}"/>
                                    </Border>
                                    <TextBlock Text="How closely to match" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="STRENGTH TOLERANCE (%)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txt_BeamStrengthTolerance"
                                                 TextChanged="txt_ParseTextSettings_TextChanged"/>
                                        <TextBlock Style="{StaticResource HelpText}"
                                                   Text="A reused member may be this much weaker than the one it replaces."/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="DEPTH TOLERANCE (MM)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txt_SteelBeamDepthTolerance"
                                                 TextChanged="txt_ParseTextSettings_TextChanged"/>
                                        <TextBlock Style="{StaticResource HelpText}"
                                                   Text="Allowed deviation from the required section depth."/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="VIEW COLOURS" Style="{StaticResource FieldLabel}"/>
                                        <WrapPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                                                <Button x:Name="btn_ColourMinedReused"
                                                        Style="{StaticResource CircleSwatchButton}"
                                                        Click="btn_ColourMinedReused_Click"/>
                                                <TextBlock Text="Mined, reused" VerticalAlignment="Center"
                                                           Foreground="{StaticResource InkMuted}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                                                <Button x:Name="btn_ColourMinedNotReused"
                                                        Style="{StaticResource CircleSwatchButton}"
                                                        Click="btn_ColourMinedNotReused_Click"/>
                                                <TextBlock Text="Mined, not reused" VerticalAlignment="Center"
                                                           Foreground="{StaticResource InkMuted}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                                                <Button x:Name="btn_ColourRequiredReused"
                                                        Style="{StaticResource CircleSwatchButton}"
                                                        Click="btn_ColourRequiredReused_Click"/>
                                                <TextBlock Text="New, from reuse" VerticalAlignment="Center"
                                                           Foreground="{StaticResource InkMuted}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                                                <Button x:Name="btn_ColourRequiredNotReused"
                                                        Style="{StaticResource CircleSwatchButton}"
                                                        Click="btn_ColourRequiredNotReused_Click"/>
                                                <TextBlock Text="New, not from reuse" VerticalAlignment="Center"
                                                           Foreground="{StaticResource InkMuted}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                                                <Button x:Name="btn_ColourMassReusable"
                                                        Style="{StaticResource CircleSwatchButton}"
                                                        Click="btn_ColourMassReusable_Click"/>
                                                <TextBlock Text="Reusable mass" VerticalAlignment="Center"
                                                           Foreground="{StaticResource InkMuted}"/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- What deconstruction takes -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource BigBadge}">
                                        <TextBlock Text="4" Style="{StaticResource BigBadgeText}"/>
                                    </Border>
                                    <TextBlock Text="What deconstruction takes" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>

                                <TextBlock Foreground="{StaticResource InkMuted}" Margin="0,0,0,14"
                                           Text="Length lost releasing an existing member, per end. Taken off both ends of everything on the mined side, and charged again on each new end a cut creates. Proposed members are never reduced."/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="STEEL, EACH END (MM)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txt_SteelCutoffLength"
                                                 TextChanged="txt_ParseTextSettings_TextChanged"/>
                                        <TextBlock Style="{StaticResource HelpText}" Text="Usually 600 mm."/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="TIMBER, EACH END (MM)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txt_TimberCutoffLength"
                                                 TextChanged="txt_ParseTextSettings_TextChanged"/>
                                        <TextBlock Style="{StaticResource HelpText}" Text="Usually 300 mm."/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Style="{StaticResource HelpText}" Margin="0,16,0,0"
                                                   Text="Lowering an allowance recovers usable length, but only if the deconstruction method on site can release the ends that cleanly. Concrete and masonry losses are volume percentages rather than lengths, and stay in Advanced settings."/>
                                    </StackPanel>
                                </Grid>

                                <!--
                                    Both notes sit under the whole row rather than under their own
                                    field. At 200 px the message wraps to three lines, which pushes
                                    the two columns out of step with each other and moves the card
                                    below this one every time a digit is typed.

                                    Shown by refreshCutoffWarnings() when a value falls below its
                                    advisory minimum in carboCircleSettings.
                                -->
                                <Border x:Name="wrn_SteelCutoff" Style="{StaticResource WarnNote}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource WarnText}" FontWeight="Bold"
                                                   Text="Steel:" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="txt_SteelCutoffWarning"
                                                   Style="{StaticResource WarnText}"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="wrn_TimberCutoff" Style="{StaticResource WarnNote}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource WarnText}" FontWeight="Bold"
                                                   Text="Timber:" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="txt_TimberCutoffWarning"
                                                   Style="{StaticResource WarnText}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================= 2. AVAILABLE STOCK ========================= -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="2" Style="{StaticResource StepBadgeText}"/>
                        </Border>
                        <TextBlock Text="Available stock" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="180"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="120"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ListTitleBar}">
                        <Grid>
                            <TextBlock Text="Members recovered from the existing structure"
                                       Style="{StaticResource ListTitleText}" HorizontalAlignment="Left"/>
                            <Button Content="Export to CSV" HorizontalAlignment="Right" Margin="0"
                                    Style="{StaticResource BarButton}"
                                    Click="btn_ExportMinedToCSV"/>
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" x:Name="liv_MinedData" Style="{StaticResource DataGridList}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="NAME" Width="180">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding name}" Style="{StaticResource Cell}" FontWeight="Medium"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CATEGORY" Width="130">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding category}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="SECTION" Width="150">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding standardName}" Style="{StaticResource Cell}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="MATERIAL" Width="150">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding materialName}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CLASS" Width="90">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding materialClass}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="LENGTH" Width="85">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding length, StringFormat=N3}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="USABLE LENGTH" Width="122">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding netLength, StringFormat=N3}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="GRADE" Width="90">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding grade}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CONDITION" Width="98">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding quality}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="FAMILY" Width="130">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding standardCategory}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="DEPTH" Width="70">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding standardDepth}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="WIDTH" Width="70">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding standardWidth}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="IY" Width="80">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Iy}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="WELY" Width="80">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Wy}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="ID" Width="75">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding id}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="HUMAN ID" Width="95">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding humanId}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="GUID" Width="90">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding GUID}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="MATCH GUID" Width="105">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding matchGUID}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="3" Style="{StaticResource ListTitleBar}">
                        <TextBlock Text="Bulk volumes" Style="{StaticResource ListTitleText}"/>
                    </Border>

                    <ListView Grid.Row="4" x:Name="liv_MinedMassObjects" Style="{StaticResource DataGridList}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="NAME" Width="200">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding name}" Style="{StaticResource Cell}" FontWeight="Medium"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CATEGORY" Width="150">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding category}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="MATERIAL" Width="180">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding materialName}" Style="{StaticResource Cell}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CLASS" Width="100">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding materialClass}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="VOLUME" Width="110">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding volume, StringFormat=N3}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="NET VOLUME" Width="118">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding netVolume, StringFormat=N3}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="ID" Width="75">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding id}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- ============================= 3. REQUIRED ============================= -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="3" Style="{StaticResource StepBadgeText}"/>
                        </Border>
                        <TextBlock Text="Required" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="180"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="120"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ListTitleBar}">
                        <Grid>
                            <TextBlock Text="Members required by the proposed frame"
                                       Style="{StaticResource ListTitleText}" HorizontalAlignment="Left"/>
                            <Button Content="Export to CSV" HorizontalAlignment="Right" Margin="0"
                                    Style="{StaticResource BarButton}"
                                    Click="btn_ExportProjectData_Click"/>
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" x:Name="liv_requiredMaterialList" Style="{StaticResource DataGridList}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="NAME" Width="180">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding name}" Style="{StaticResource Cell}" FontWeight="Medium"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CATEGORY" Width="130">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding category}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!-- SECTION is standardName and FAMILY is standardCategory, the same
                                     way round as the two grids above. The previous window had these
                                     two headers swapped on this grid only. -->
                                <GridViewColumn Header="SECTION" Width="150">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding standardName}" Style="{StaticResource Cell}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="MATERIAL" Width="150">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding materialName}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CLASS" Width="90">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding materialClass}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="LENGTH" Width="85">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding length, StringFormat=N3}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="GRADE" Width="90">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding grade}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CONDITION" Width="98">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding quality}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="FAMILY" Width="130">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding standardCategory}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="DEPTH" Width="70">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding standardDepth}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="WIDTH" Width="70">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding standardWidth}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="IY" Width="80">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Iy}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="WELY" Width="80">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Wy}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="ID" Width="75">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding id}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="GUID" Width="90">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding GUID}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="MATCH GUID" Width="105">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding matchGUID}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="3" Style="{StaticResource ListTitleBar}">
                        <TextBlock Text="Bulk volumes required" Style="{StaticResource ListTitleText}"/>
                    </Border>

                    <ListView Grid.Row="4" x:Name="liv_RequiredMassObjects" Style="{StaticResource DataGridList}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="NAME" Width="200">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding name}" Style="{StaticResource Cell}" FontWeight="Medium"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CATEGORY" Width="150">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding category}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="MATERIAL" Width="180">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding materialName}" Style="{StaticResource Cell}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="VOLUME" Width="110">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding volume, StringFormat=N3}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="ID" Width="75">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding id}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- =========================== 4. OPPORTUNITIES =========================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock Text="4" Style="{StaticResource StepBadgeText}"/>
                        </Border>
                        <TextBlock Text="Opportunities" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*" MinHeight="180"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="90"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="110"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource ListTitleBar}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Reusable beams and columns"
                                           Style="{StaticResource ListTitleText}" HorizontalAlignment="Left"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btn_Select" Content="Select pair"
                                            Style="{StaticResource BarButton}"
                                            Click="btn_Select_Click"/>
                                    <Button x:Name="btn_Visualise" Content="Colour the view"
                                            Style="{StaticResource BarButton}"
                                            Click="btn_Visualise_Click"/>

                                    <!--
                                        The only button on this window that changes the
                                        model. The parameter it writes to is named beside
                                        it rather than only in the settings, because "write
                                        IDs into the model" is not a thing to press without
                                        knowing where they land.

                                        txt_ReuseIdParameter is filled from the settings
                                        every time they are loaded, so it cannot drift from
                                        what the write will actually use.
                                    -->
                                    <TextBlock x:Name="txt_ReuseIdParameter"
                                               Foreground="{StaticResource InkMuted}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="4,0,8,0"
                                               Text="CLC_ReuseID"
                                               ToolTip="The instance parameter the reuse IDs are written into. Change it under Settings."/>
                                    <Button x:Name="btn_WriteReuseIds" Content="Write ID parameters into model"
                                            Style="{StaticResource BarButton}" Margin="0"
                                            Click="btn_WriteReuseIds_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- The legend for the stripe in the first column. -->
                            <WrapPanel Margin="0,9,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource MatchExactEdge}"/>
                                    <TextBlock Style="{StaticResource LegendText}" Text="100% match"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource MatchAdequateEdge}"/>
                                    <TextBlock Style="{StaticResource LegendText}" Text="Structurally good enough"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource MatchCrossEdge}"/>
                                    <TextBlock Style="{StaticResource LegendText}" Text="Different shape - check"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource MatchOffcutEdge}"/>
                                    <TextBlock Style="{StaticResource LegendText}" Text="From an offcut"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource LegendSwatch}" Background="{StaticResource MatchNoneEdge}"/>
                                    <TextBlock Style="{StaticResource LegendText}" Text="No match"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!--
                        Grouped and coloured by match category. The grouping itself is applied in
                        code-behind after ItemsSource is set - see applyMatchGrouping in
                        CarboCircleMain.xaml.cs - because the list is rebuilt on every run and a
                        view configured before the source exists has nothing to configure.

                        The GroupStyle below has to be declared here: without it WPF leaves
                        IsGrouping false and the grouping applied in code-behind does nothing at
                        all, silently.
                    -->
                    <ListView Grid.Row="1" x:Name="liv_MatchedFraming"
                              Style="{StaticResource DataGridList}"
                              ItemContainerStyle="{StaticResource MatchRowStyle}">
                        <ListView.GroupStyle>
                            <GroupStyle/>
                        </ListView.GroupStyle>
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <!-- The category, as a colour. In a CellTemplate rather than on the
                                     row, so it is still visible when the row is selected - which it
                                     has to be for Select pair to work. -->
                                <GridViewColumn Header="" Width="26">
                                    <GridViewColumn.CellTemplate><DataTemplate><Border Style="{StaticResource MatchStripe}" ToolTip="{Binding matchCategory}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="ELEMENT" Width="170">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding required_Name}" Style="{StaticResource Cell}" FontWeight="Medium"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="ID" Width="75">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding required_id}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="LENGTH" Width="80">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding required_length, StringFormat=N2}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="SUBSTITUTED WITH" Width="170">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding mined_Name}" Style="{StaticResource Cell}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="MINED ID" Width="80">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding mined_id}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="USABLE LENGTH" Width="122">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding mined_netLength, StringFormat=N2}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="OFFCUT" Width="85">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding offcut_netLength, StringFormat=N2}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!-- Named for what it is. "Capacity used" reads as a design
                                     utilisation, which this is not - it is the ratio of the two
                                     elastic section moduli, and it says nothing about loads, shear
                                     or buckling. -->
                                <GridViewColumn Header="WEL USED" Width="85">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding match_Score, StringFormat={}{0:N0}%}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="MATCH" Width="150">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding matchCategory}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="REASON" Width="520">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding description}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="3" Style="{StaticResource ListTitleBar}">
                        <TextBlock Text="Reusable mass materials" Style="{StaticResource ListTitleText}"/>
                    </Border>

                    <ListView Grid.Row="4" x:Name="liv_MatchedVolumes" Style="{StaticResource DataGridList}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="NAME" Width="200">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding name}" Style="{StaticResource Cell}" FontWeight="Medium"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CATEGORY" Width="150">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding category}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="MATERIAL" Width="180">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding materialName}" Style="{StaticResource Cell}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CLASS" Width="100">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding materialClass}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="VOLUME" Width="110">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding volume, StringFormat=N3}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="USABLE VOLUME" Width="126">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding netVolume, StringFormat=N3}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="ID" Width="75">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding id}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="6" Style="{StaticResource ListTitleBar}">
                        <TextBlock Text="Left over - offcuts and members nobody claimed"
                                   Style="{StaticResource ListTitleText}"/>
                    </Border>

                    <!-- applyLeftOverGrouping() groups this one on sourceLabel; same note about
                         the GroupStyle as the matched grid above. -->
                    <ListView Grid.Row="7" x:Name="liv_LeftOverData" Style="{StaticResource DataGridList}">
                        <ListView.GroupStyle>
                            <GroupStyle/>
                        </ListView.GroupStyle>
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="NAME" Width="180">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding name}" Style="{StaticResource Cell}" FontWeight="Medium"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CATEGORY" Width="130">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding category}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="SECTION" Width="150">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding standardName}" Style="{StaticResource Cell}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="MATERIAL" Width="150">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding materialName}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CLASS" Width="90">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding materialClass}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="LENGTH" Width="85">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding length, StringFormat=N3}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="USABLE LENGTH" Width="122">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding netLength, StringFormat=N3}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="NOTE" Width="180">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding grade}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CONDITION" Width="98">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding quality}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="FAMILY" Width="130">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding standardCategory}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="DEPTH" Width="70">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding standardDepth}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="IY" Width="80">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Iy}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="WELY" Width="80">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Wy}" Style="{StaticResource CellNumeric}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="ID" Width="75">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding id}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="HUMAN ID" Width="95">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding humanId}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="GUID" Width="90">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding GUID}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="MATCH GUID" Width="105">
                                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding matchGUID}" Style="{StaticResource CellQuiet}"/></DataTemplate></GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ============================== ACTION BAR ============================== -->
        <Border Grid.Row="1" Style="{StaticResource ActionBar}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="btn_MineSettings" Content="Advanced settings" MinWidth="140"
                            Click="btn_MineSettings_Click"/>
                    <Button x:Name="btn_Report" Content="Export report" Click="btn_Report_Click"/>
                    <Button x:Name="btn_GenerateReport" Content="Open in Carbo Life Calc"
                            MinWidth="170" Click="btn_GenerateReport_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_Close" Content="Close" Click="btn_Close_Click"/>
                    <Button x:Name="btn_Go" Content="Find opportunities" Margin="0"
                            MinWidth="160" Style="{StaticResource CirclePrimaryButton}"
                            Click="btn_Go_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
