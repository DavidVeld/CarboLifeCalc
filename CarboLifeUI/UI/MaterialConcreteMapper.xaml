<Window x:Class="CarboLifeUI.UI.MaterialConcreteMapper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wpf="http://schemas.microsoft.com/wpf/2008/toolkit"
             xmlns:local="clr-namespace:CarboLifeUI.UI"
             mc:Ignorable="d" Title="Reinforcement Auto-Mapper"
             d:DesignHeight="540" d:DesignWidth="800" Height="530" Width="800" MinHeight="530" MinWidth="800" Loaded="Window_Loaded" ShowInTaskbar="True" Background="WhiteSmoke" Icon="pack://application:,,,/CarboLifeUI;component/Resources/ico_clcwindow.ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="MyStyles.xaml">
                </ResourceDictionary>
                <ResourceDictionary Source="MyDataGrid.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="35"/>
            <!-- The note, the parameter row, and a line under it for a parameter this model has
                 no match for. -->
            <RowDefinition Height="118"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="1*"/>

            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="5"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource baseStyleTitle}">Concrete Reinforcement Mapper</Label>

        <TextBox Name="txt_Note" Visibility="Visible" Grid.Column="2" Margin="5,5,5,0" Grid.Row="2" Style="{StaticResource baseStyle}" TextWrapping="Wrap" Height="46" VerticalAlignment="Top" BorderBrush="Transparent" IsReadOnly="True">The parameter below defines a local override to reinforcement density (kg/m³). The reinforcement material and material category are set in the import settings, next to the template.</TextBox>
        <ComboBox Visibility="Visible"  Name="cbb_RCImportType" IsReadOnly="False" Grid.Column="2" Grid.Row="2" Margin="30,0,0,28" Height="28" Width="150" VerticalAlignment="Bottom" HorizontalAlignment="Left" Style="{StaticResource ComboBoxFlatStyle}" SelectionChanged="cbb_RCImportType_SelectionChanged"></ComboBox>
        <!-- A picker over the parameters of the model that was read on the way in, outlined when
             it names one the model does not have; see CarboParameterPicker. -->
        <ComboBox Visibility="Visible"  Name="cbb_RCImportValue" Grid.Column="2" Grid.Row="2" Margin="185,0,5,28" Height="28" VerticalAlignment="Bottom" Style="{StaticResource ParameterComboBoxStyle}" />
        <TextBlock Name="txt_RCParamWarning" Grid.Column="2" Grid.Row="2" Margin="30,0,5,4" VerticalAlignment="Bottom"
                   FontSize="11" FontWeight="SemiBold" Foreground="#C05000" TextWrapping="Wrap" Visibility="Collapsed"/>

        <!-- Only shown when the mapper is opened on a project: the import settings dialog edits the
             same two values against the selected template, so it does not need them repeated here. -->
        <Grid Name="pnl_Materials" Grid.Column="2" Grid.Row="3" Margin="5,0,5,5" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource baseStyle}" TextWrapping="Wrap" Margin="0,0,0,6"
                     BorderBrush="Transparent" IsReadOnly="True">Every group whose material sits in the category below is reinforced, with the material below:</TextBox>

            <Label Grid.Row="1" Grid.Column="0" Style="{StaticResource baseStyle}" Height="28" VerticalAlignment="Center">Concrete material category:</Label>
            <ComboBox Name="cbb_RCMaterialCategory" Grid.Row="1" Grid.Column="1" Height="26" Margin="0,0,0,6"
                      Style="{StaticResource ComboBoxFlatStyle}"
                      SelectionChanged="Cbb_Material_SelectionChanged"
                      ToolTip="Groups whose material sits in this category get reinforcement added"/>

            <Label Grid.Row="2" Grid.Column="0" Style="{StaticResource baseStyle}" Height="28" VerticalAlignment="Center">Reinforcement material:</Label>
            <ComboBox Name="cbb_RCMaterial" Grid.Row="2" Grid.Column="1" Height="26" Margin="0,0,0,6"
                      Style="{StaticResource ComboBoxFlatStyle}"
                      SelectionChanged="Cbb_Material_SelectionChanged"
                      ToolTip="The material the generated reinforcement groups are made of"/>

            <TextBlock Name="txt_Warning" Grid.Row="3" Grid.ColumnSpan="2" FontSize="11" FontWeight="SemiBold"
                       Foreground="#C05000" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed"/>
        </Grid>

        <TextBox Grid.Column="2" Margin="5,5,5,0" Grid.Row="4" Style="{StaticResource baseStyle}" TextWrapping="Wrap" Height="28" VerticalAlignment="Top" BorderBrush="Transparent" IsReadOnly="True">The mapping table:</TextBox>

        <DataGrid Name="dgData2" AutoGenerateColumns="False" ItemsSource="{Binding rcMap}" CanUserAddRows="True" Grid.Column="2" Grid.Row="4" Margin="5,35,5,10">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding PropertyName}" Header="Category" Width="1*"/>
                <DataGridTextColumn Binding="{Binding Value}" Header=" Density kg/m³" Width="135"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Name="btn_Accept" Grid.Row="6" Grid.Column="2" Margin="0,0,85,0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="70" Height="30" Style="{StaticResource ButtonStyle}" Click="Btn_Accept_Click">Accept</Button>
        <Button Name="btn_Cancel" Grid.Row="6" Grid.Column="2" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="70" Height="30" Style="{StaticResource ButtonStyle}" Click="Btn_Cancel_Click">Cancel</Button>

    </Grid>
</Window>
