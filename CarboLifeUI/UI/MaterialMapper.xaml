<Window x:Class="CarboLifeUI.UI.MaterialMapper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:wpf="http://schemas.microsoft.com/wpf/2008/toolkit"
             xmlns:local="clr-namespace:CarboLifeUI.UI"
             mc:Ignorable="d" Title="Map Materials to Model Dialog"
             d:DesignHeight="700" d:DesignWidth="800" Height="650" Width="800" MinHeight="650" MinWidth="800" Loaded="Window_Loaded" ShowInTaskbar="True" Background="LightGray" Icon="pack://application:,,,/CarboLifeUI;component/Resources/ico_clcwindow.ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="MyStyles.xaml">
                </ResourceDictionary>
                <ResourceDictionary Source="MyDataGrid.xaml"/>
            </ResourceDictionary.MergedDictionaries>
          </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="1*"/>

            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="5"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource baseStyleTitle}">Material Mapper</Label>

        <!-- Said out loud because it is not discoverable: the column looks like a dropdown, and
             nobody tries typing into a dropdown unless told they may. -->
        <TextBlock Grid.Column="2" Grid.Row="1" Margin="0,0,10,0"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   FontFamily="Segoe UI" FontSize="12" Foreground="#555"
                   Text="Type any part of a material name to search, or pick one from the list."/>

        <!-- VirtualizationMode Standard, not the DataGrid's usual Recycling. A recycled row hands
             the SAME combo box to a different material, and a combo box carries state that does
             not survive that: the narrowed dropdown of whoever had it last, and a selection that
             belongs to a row no longer under it. Rows here are counted in tens, so a container
             per realised row costs nothing and removes the whole class of bug. -->
        <DataGrid Name="dgData2" AutoGenerateColumns="False" ItemsSource="{Binding mappinglist}" CanUserAddRows="False"
                  VirtualizingPanel.VirtualizationMode="Standard"
                  Grid.Column="2" Grid.Row="4" Margin="5,0,5,10">
            <DataGrid.Columns>
                <!-- Read only: these two are the KEY the mapping is looked up by. A stray
                     keystroke in the Revit name used to detach the row from its group silently. -->
                <DataGridTextColumn Binding="{Binding revitName}" Header=" Revit Material Name" Width="1*" IsReadOnly="True"/>
                <DataGridTextColumn Binding="{Binding category}" Header=" Category" Width="135" IsReadOnly="True"/>
                <DataGridTextColumn Binding="{Binding additionalData}" Header=" Additional" Width="135" Visibility="Hidden" IsReadOnly="True"/>

                <DataGridTemplateColumn Header="Carbo Life Calc Material Name" Width="1.2*" SortMemberPath="carboNAME">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Text, not SelectedValue, and ItemsSource written FIRST.
                                 Binding the VALUE rather than the SELECTION is what makes typing
                                 and pasting work: an editable combo box only turns text into a
                                 selection when its own prefix search is on, and that search is
                                 off here because it cannot find "C32/40 concrete" from "c32".
                                 Bound to SelectedValue, anything typed or pasted was displayed
                                 but never stored - which is the bug this column had.
                                 Handing it the items clears the text of an editable combo box,
                                 so ItemsSource has to be set before the text binding, not after.
                                 See MaterialMapper.xaml.cs for the rest. -->
                            <ComboBox ItemsSource="{Binding materialNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Text="{Binding carboNAME, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                      Style="{StaticResource ParameterComboBoxStyle}"
                                      FontSize="14" Margin="1,2,1,2"
                                      StaysOpenOnEdit="True"
                                      Loaded="MaterialBox_Loaded"
                                      DropDownOpened="MaterialBox_DropDownOpened"
                                      DataContextChanged="MaterialBox_DataContextChanged"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <CheckBox Name="chk_SaveMappingFile" IsEnabled="True"  Grid.Row="6" Grid.Column="2" Margin="0,5,10,0" Height="25" VerticalAlignment="Top" Style="{StaticResource baseStyleBold}" IsChecked="True">Save These Mapping Settings for Next Imports !</CheckBox>

        <Button Name="btn_Accept" Grid.Row="6" Grid.Column="2" Margin="0,0,85,0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="70" Height="30" Style="{StaticResource ButtonStyle}" Click="Btn_Accept_Click">Accept</Button>
        <Button Name="btn_Cancel" Grid.Row="6" Grid.Column="2" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="70" Height="30" Style="{StaticResource ButtonStyle}" Click="Btn_Cancel_Click">Cancel</Button>

    </Grid>
</Window>
