<Window x:Class="CarboLifeUI.UI.CarboGroupingSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Carbo Life Calculator: Revit Import Settings"
        Width="1320" Height="900" MinWidth="1320" MinHeight="900"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        Icon="pack://application:,,,/CarboLifeUI;component/Resources/ico_clcwindow.ico">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MyStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="12,8,12,12"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>

            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="Gray"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,2,0,6"/>
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
            </Style>

            <Style x:Key="CheckSection" TargetType="CheckBox" BasedOn="{StaticResource baseStyleBold}">
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <Style x:Key="WarningText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#C05000"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Visibility" Value="Collapsed"/>
            </Style>

            <!-- One allowance block: everything inside belongs to the tickbox at the top of it -->
            <Style x:Key="AllowanceBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="8,6,8,8"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="10">

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Name="btn_ExportSettings" Width="90" Height="26" Margin="0,0,6,0"
                            Style="{StaticResource ButtonStyle}" Click="btn_ExportSettings_Click">Export Settings</Button>
                    <Button Name="btn_ImportSettings" Width="90" Height="26"
                            Style="{StaticResource ButtonStyle}" Click="btn_ImportSettings_Click">Import Settings</Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Name="btn_ImportClose" Width="100" Height="26" Margin="0,0,8,0"
                            Style="{StaticResource ButtonStyle}" Click="Btn_ImportClose_Click">Ok &amp; Import</Button>
                    <Button Name="btn_Cancel" Width="80" Height="26"
                            Style="{StaticResource ButtonStyle}" Click="Btn_Cancel_Click">Cancel</Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main columns. Scrolls rather than clips, the allowance column keeps growing. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ LEFT: Basic Settings ═══ -->
            <Border Grid.Column="0" Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <Label Style="{StaticResource baseStyleTitle}" Content="Basic Element Import Settings" Margin="0,0,0,8"/>

                    <!-- Update Project, hidden. Leaving projectPath empty imports as a new project. -->
                    <StackPanel Name="pnl_UpdateProject" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}">Update project</TextBlock>
                        <TextBlock Style="{StaticResource HintText}">Select an existing project if you want to update it</TextBlock>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="txt_ProjectPath" Grid.Column="0" Height="26"
                                     Style="{StaticResource textboxReadOnlyStyle}" IsEnabled="False"/>
                            <Button Name="btn_ProjectPath" Grid.Column="1" Margin="4,0,0,0"
                                    Height="26" Style="{StaticResource ButtonStyle}"
                                    Click="btn_ProjectPath_Click">…</Button>
                        </Grid>
                    </StackPanel>

                    <!-- Template -->
                    <TextBlock Style="{StaticResource FieldLabel}">Material Template</TextBlock>
                    <TextBlock Style="{StaticResource HintText}">Select the material template to use for this project</TextBlock>
                    <ComboBox Name="cbb_Template" Height="26" Margin="0,0,0,12"
                              Style="{StaticResource ComboBoxFlatStyle}"
                              SelectionChanged="cbb_Template_SelectionChanged"/>
                        <!-- Category -->
                    <TextBlock Style="{StaticResource FieldLabel}">Category</TextBlock>
                    <TextBlock Style="{StaticResource HintText}">The main grouping value. Defaults to the Revit Category Name; override with a custom parameter.</TextBlock>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Name="cbb_MainGroup" Grid.Column="0" Height="26" Margin="0,0,6,0"
                                  Style="{StaticResource ComboBoxFlatStyle}"
                                  DropDownClosed="cbb_MainGroup_DropDownClosed"/>
                        <TextBox Name="txt_CategoryparamName" Grid.Column="1" Height="26"
                                 Style="{StaticResource flatTextBox}"/>
                    </Grid>

                    <!-- Uncertainty Factor -->
                    <TextBlock Style="{StaticResource FieldLabel}">Uncertainty factor</TextBlock>
                    <TextBlock Style="{StaticResource HintText}">RICS guideline: 15% early stage · 10% design stage · 1% construction</TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBox Name="txt_UncertFact" Width="100" Height="26"
                                 Style="{StaticResource flatTextBox}"/>
                        <Label Content="%" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <!-- ─── The two files this import reads and writes ───
                         The template list above shows file names; which file a name resolves to,
                         and which mapping file the previous material matches come from, are both
                         decided elsewhere. Shown here so they can be checked before importing
                         rather than found out afterwards, from the numbers. -->
                    <Border Style="{StaticResource AllowanceBorder}">
                        <StackPanel>
                            <Label Style="{StaticResource baseStyleBold}" Padding="0" Margin="0,0,0,2"
                                   Content="Files used for this import"/>
                            <TextBlock Style="{StaticResource HintText}">
                                Check both before importing. Change points at a file anywhere on disk;
                                Reload re-reads the materials folder and the selected database.
                            </TextBlock>

                            <TextBlock Style="{StaticResource FieldLabel}">Material database</TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Wrapping rather than one clipped line: the file name sits at the
                                     end of a path, so a box that shows only the start of it answers
                                     nothing. There is room for it in this column. -->
                                <TextBox Name="txt_TemplateFilePath" Grid.Column="0" MinHeight="26"
                                         Style="{StaticResource textboxReadOnlyStyle}"
                                         IsReadOnly="True" TextWrapping="Wrap" Padding="2,4,2,4"/>
                                <Button Name="btn_ReloadTemplates" Grid.Column="1" Margin="4,0,0,0"
                                        Width="70" Height="26" VerticalAlignment="Top"
                                        Style="{StaticResource ButtonStyle}"
                                        Click="btn_ReloadTemplates_Click"
                                        ToolTip="Re-read the materials folder and the selected database">Reload</Button>
                                <Button Name="btn_TemplatePath" Grid.Column="2" Margin="4,0,0,0"
                                        Width="78" Height="26" VerticalAlignment="Top"
                                        Style="{StaticResource ButtonStyle}"
                                        Click="btn_TemplatePath_Click"
                                        ToolTip="Pick a material database from anywhere on disk">Change…</Button>
                            </Grid>
                            <TextBlock x:Name="txt_TemplateFileStatus" Style="{StaticResource HintText}"/>

                            <TextBlock Style="{StaticResource FieldLabel}">Material mapping file</TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <!-- Empty, standing in for the Reload button above it, so both
                                         path boxes are the same width and both Change buttons line up.
                                         There is nothing to reload for a single file. -->
                                    <ColumnDefinition Width="74"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Name="txt_MappingFilePath" Grid.Column="0" MinHeight="26"
                                         Style="{StaticResource textboxReadOnlyStyle}"
                                         IsReadOnly="True" TextWrapping="Wrap" Padding="2,4,2,4"/>
                                <Button Name="btn_MappingPath" Grid.Column="2" Margin="4,0,0,0"
                                        Width="78" Height="26" VerticalAlignment="Top"
                                        Style="{StaticResource ButtonStyle}"
                                        Click="btn_MappingPath_Click"
                                        ToolTip="Point this import at another mapping file">Change…</Button>
                            </Grid>
                            <TextBlock x:Name="txt_MappingFileStatus" Style="{StaticResource HintText}"/>

                            <CheckBox Name="chk_UseMappedMaterialData" IsChecked="True"
                                      Style="{StaticResource CheckSection}" Margin="0,4,0,0">
                                Use previously mapped materials
                            </CheckBox>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0">
                                Matches the imported materials against the mapping file above. New
                                matches are written back to it.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ═══ RIGHT: Advanced Settings ═══ -->
            <Border Grid.Column="2" Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <Label Style="{StaticResource baseStyleTitle}" Content="Advanced Element Import Settings" Margin="0,0,0,8"/>

                    <!-- Substructure -->
                    <CheckBox x:Name="chk_ImportSubstructure" Style="{StaticResource CheckSection}">
                        Group by substructure parameter
                    </CheckBox>
                    <TextBlock Style="{StaticResource HintText}">Define a parameter to identify the building's substructure</TextBlock>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Name="cbb_SubstructureImportType" Grid.Column="0" Height="26" Margin="0,0,6,0"
                                  Style="{StaticResource ComboBoxFlatStyle}"/>
                        <TextBox Name="txt_SubstructureParamName" Grid.Column="1" Height="26"
                                 Style="{StaticResource flatTextBox}"/>
                    </Grid>

                    <!-- Material Grade -->
                    <CheckBox Name="chk_MaterialGrade" Style="{StaticResource CheckSection}">
                        Group by material grade
                    </CheckBox>
                    <TextBlock Style="{StaticResource HintText}">Define a parameter to import material grade</TextBlock>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Name="cbb_GradeImportType" Grid.Column="0" Height="26" Margin="0,0,6,0"
                                  Style="{StaticResource ComboBoxFlatStyle}"/>
                        <TextBox Name="txt_GradeImportValue" Grid.Column="1" Height="26"
                                 Style="{StaticResource flatTextBox}"/>
                    </Grid>

                    <!-- Correction Parameter -->
                    <CheckBox Name="chk_doCorrection" Style="{StaticResource CheckSection}">
                        Group by correction parameter
                    </CheckBox>
                    <TextBlock Style="{StaticResource HintText}">Define a parameter for material volume corrections</TextBlock>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Name="cbb_CorrectionImportType" Grid.Column="0" Height="26" Margin="0,0,6,0"
                                  Style="{StaticResource ComboBoxFlatStyle}"/>
                        <TextBox Name="txt_CorrectionImportValue" Grid.Column="1" Height="26"
                                 Style="{StaticResource flatTextBox}"/>
                    </Grid>

                    <!-- Additional Parameter -->
                    <CheckBox Name="chk_AdditionalImport" Style="{StaticResource CheckSection}">
                        Group by additional parameter
                    </CheckBox>
                    <TextBlock Style="{StaticResource HintText}">Define an additional parameter to group the import</TextBlock>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Name="cbb_ExtraImportType" Grid.Column="0" Height="26" Margin="0,0,6,0"
                                  Style="{StaticResource ComboBoxFlatStyle}"/>
                        <TextBox Name="txt_ExtraImportValue" Grid.Column="1" Height="26"
                                 Style="{StaticResource flatTextBox}"/>
                    </Grid>

                    <Separator Margin="0,0,0,12"/>

                    <!-- Existing Elements -->
                    <CheckBox Name="chk_ImportExisting" Style="{StaticResource CheckSection}">
                        Include &amp; group existing elements
                    </CheckBox>
                    <TextBlock Style="{StaticResource HintText}">Define the name of the "existing" phase below</TextBlock>
                    <TextBox Name="txt_ExistingPhaseName" Height="26" Margin="0,0,0,12"
                             Style="{StaticResource flatTextBox}"/>

                    <!-- Demolished Elements -->
                    <CheckBox Name="chk_ImportDemolished" Style="{StaticResource CheckSection}">
                        Include &amp; group demolished elements
                    </CheckBox>

                    <Separator Margin="0,12,0,12"/>

                    <!-- ─── Gross Internal Area ───
                         The GIA every intensity figure is divided by. Leaving a name empty
                         switches that one off and falls back to the floor measurement.
                         Here rather than beside the uncertainty factor it belongs with: the
                         left column already fills the window, this one has the room. -->
                    <Label Style="{StaticResource baseStyleBold}" Padding="0" Margin="0,0,0,2"
                           Content="Gross Internal Area"/>
                    <TextBlock Style="{StaticResource HintText}">
                        Project Information parameters holding the GIA. Filled in they are what the import
                        uses, otherwise the floors in the view are measured. Either way the result is
                        written back to them when the calculator closes.
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}">Total GIA parameter</TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}">New GIA parameter</TextBlock>

                        <TextBox Name="txt_GIAParamName" Grid.Row="1" Grid.Column="0" Height="26"
                                 Style="{StaticResource flatTextBox}"
                                 ToolTip="Project Information parameter holding the total GIA. Leave empty to always measure the floors."/>
                        <TextBox Name="txt_GIANewParamName" Grid.Row="1" Grid.Column="2" Height="26"
                                 Style="{StaticResource flatTextBox}"
                                 ToolTip="Project Information parameter holding the new build GIA. Leave empty to always measure the floors."/>
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,2">Determination method of the last import</TextBlock>
                    <TextBox Name="txt_GIAMethod" Height="26"
                             Style="{StaticResource textboxReadOnlyStyle}"
                             IsReadOnly="True" IsEnabled="False"
                             ToolTip="Recorded by the import, not set here. Use the parameter check tool to add the default parameters to a model that has none."/>

                </StackPanel>
            </Border>

            <!-- ═══ RIGHT: Allowances ═══ -->
            <Border Grid.Column="4" Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <Label Style="{StaticResource baseStyleTitle}" Content="Allowances Added on Import" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8">
                        Each block below applies only to its own tick box. Materials and categories come from the
                        selected template — check them whenever you change it.
                    </TextBlock>

                    <!-- ─── Reinforcement ─── -->
                    <Border Style="{StaticResource AllowanceBorder}">
                        <StackPanel>
                            <CheckBox Name="chk_MapReinforcement" Style="{StaticResource CheckSection}"
                                      Checked="chk_MapReinforcement_Toggled" Unchecked="chk_MapReinforcement_Toggled">
                                Map reinforcement quantities
                            </CheckBox>
                            <TextBlock Style="{StaticResource HintText}">
                                Adds reinforcement to every group in the category below, per the density mapping table.
                            </TextBlock>



                            <TextBlock Style="{StaticResource FieldLabel}">Reinforced material category</TextBlock>
                            <ComboBox Name="cbb_RCMaterialCategory" Height="26" Margin="0,0,0,6"
                                      Style="{StaticResource ComboBoxFlatStyle}"
                                      ToolTip="Groups whose material sits in this template category get reinforcement added"/>
                            
                            <TextBlock Style="{StaticResource FieldLabel}">Reinforcement material</TextBlock>
                            <ComboBox Name="cbb_RCImportMaterial" Height="26" Margin="0,0,0,8"
                                      Style="{StaticResource ComboBoxFlatStyle}"
                                      ToolTip="The template material used for the generated reinforcement quantities"/>
                            
                            <TextBlock x:Name="txt_RCWarning" Style="{StaticResource WarningText}"/>

                            <Button x:Name="btn_ReinforcementImport" HorizontalAlignment="Left"
                                    Width="140" Height="26"
                                    Style="{StaticResource ButtonStyle}"
                                    Click="btn_ReinforcementImport_Click">Density mapping…</Button>
                        </StackPanel>
                    </Border>

                    <!-- ─── Steel connections ─── -->
                    <Border Style="{StaticResource AllowanceBorder}">
                        <StackPanel>
                            <CheckBox Name="chk_AddSteelConnections" Style="{StaticResource CheckSection}"
                                      Checked="chk_AddSteelConnections_Toggled" Unchecked="chk_AddSteelConnections_Toggled">
                                Add steel connection allowances
                            </CheckBox>
                            <TextBlock Style="{StaticResource HintText}">
                                Adds a percentage of the steel volume of every group in the category below.
                            </TextBlock>



                            <TextBlock Style="{StaticResource FieldLabel}">Steelwork material category</TextBlock>
                            <ComboBox Name="cbb_SteelMaterialCategory" Height="26" Margin="0,0,0,8"
                                      Style="{StaticResource ComboBoxFlatStyle}"
                                      ToolTip="Groups whose material sits in this template category get connections added"/>
                            
                            <TextBlock Style="{StaticResource FieldLabel}">Connection material</TextBlock>
                            <ComboBox Name="cbb_SteelConnectionMaterial" Height="26" Margin="0,0,0,8"
                                      Style="{StaticResource ComboBoxFlatStyle}"
                                      ToolTip="The template material used for the generated connection allowances"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Allowance"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Name="txt_SteelConnectionPercentage" Width="70" Height="26"
                                         Style="{StaticResource flatTextBox}"
                                         ToolTip="Percentage of the steel volume added as connections"/>
                                <Label Content="% of steel volume" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>

                            <TextBlock x:Name="txt_SteelWarning" Style="{StaticResource WarningText}"/>
                        </StackPanel>
                    </Border>

                    <!-- ─── Timber connections ─── -->
                    <Border Style="{StaticResource AllowanceBorder}">
                        <StackPanel>
                            <CheckBox Name="chk_AddTimberConnections" Style="{StaticResource CheckSection}"
                                      Checked="chk_AddTimberConnections_Toggled" Unchecked="chk_AddTimberConnections_Toggled">
                                Add timber connection allowances
                            </CheckBox>
                            <TextBlock Style="{StaticResource HintText}">
                                Adds a percentage of the timber volume of every group in the category below.
                            </TextBlock>



                            <TextBlock Style="{StaticResource FieldLabel}">Timber material category</TextBlock>
                            <ComboBox Name="cbb_TimberMaterialCategory" Height="26" Margin="0,0,0,8"
                                      Style="{StaticResource ComboBoxFlatStyle}"
                                      ToolTip="Groups whose material sits in this template category get connections added"/>
                            
                            <TextBlock Style="{StaticResource FieldLabel}">Connection material</TextBlock>
                            <ComboBox Name="cbb_TimberConnectionMaterial" Height="26" Margin="0,0,0,8"
                                      Style="{StaticResource ComboBoxFlatStyle}"
                                      ToolTip="The template material used for the generated connection allowances, usually steel"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Allowance"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Name="txt_TimberConnectionPercentage" Width="70" Height="26"
                                         Style="{StaticResource flatTextBox}"
                                         ToolTip="Percentage of the timber volume added as connections"/>
                                <Label Content="% of timber volume" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>

                            <TextBlock x:Name="txt_TimberWarning" Style="{StaticResource WarningText}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>